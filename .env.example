# ===========================================================
# Astro SkateShop — variables de entorno
# Copia este archivo como `.env` y completa tus valores.
# Ninguna variable es obligatoria para que la tienda funcione
# (las integraciones se activan solo cuando están presentes).
# ===========================================================

# --- Base de datos (SQL Server) ---
DATABASE_URL=sqlserver://localhost:1433;database=astroskateshop;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true
# Alternativa por partes (si usas MSSQL_* concreto en tu adaptador):
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=astroskateshop
MSSQL_USER=sa
MSSQL_PASSWORD=YOUR_PASSWORD

# --- Auth ---
# Secreto para firmar las sesiones (usa `openssl rand -base64 32`)
AUTH_SECRET=change-me

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Pagos (Stripe) ---
STRIPE_SECRET_KEY=sk_test_xxx

# --- Emails: elige Resend (recomendado, tier gratis) o SMTP ---
RESEND_API_KEY=re_xxx
SMTP_HOST=smtp.tuservidor.com
SMTP_PORT=465
SMTP_USER=no-reply@astroskate.co
SMTP_PASS=your-smtp-password
MAIL_FROM="Astro SkateShop <no-reply@astroskate.co>"

# --- Anti-spam: Cloudflare Turnstile (ambas claves para activarlo) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAA...

# --- Analítica: Plausible (opcional) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=astroskate.co